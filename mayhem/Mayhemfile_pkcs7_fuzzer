# Atheris (libFuzzer) target: the ELF launcher /mayhem/pkcs7_fuzzer execs python3 on mayhem/harnesses/pkcs7_fuzzer.py.
project: savantenvs/acme2certifier
target: pkcs7_fuzzer

cmds:
  - cmd: /mayhem/pkcs7_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/pkcs7_fuzzer/testsuite
