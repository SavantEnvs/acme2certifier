# Atheris (libFuzzer) target: the ELF launcher /mayhem/trigger_auth_fuzzer execs python3 on mayhem/harnesses/trigger_auth_fuzzer.py.
project: savantenvs/acme2certifier
target: trigger_auth_fuzzer

cmds:
  - cmd: /mayhem/trigger_auth_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/trigger_auth_fuzzer/testsuite
