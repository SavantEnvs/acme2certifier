# Atheris (libFuzzer) target: the ELF launcher /mayhem/cert_fuzzer execs python3 on mayhem/harnesses/cert_fuzzer.py.
project: savantenvs/acme2certifier
target: cert_fuzzer

cmds:
  - cmd: /mayhem/cert_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/cert_fuzzer/testsuite
