# Atheris (libFuzzer) target: the ELF launcher /mayhem/trigger_fuzzer execs python3 on mayhem/harnesses/trigger_fuzzer.py.
project: savantenvs/acme2certifier
target: trigger_fuzzer

cmds:
  - cmd: /mayhem/trigger_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/trigger_fuzzer/testsuite
