# Atheris (libFuzzer) target: the ELF launcher /mayhem/order_fuzzer execs python3 on mayhem/harnesses/order_fuzzer.py.
project: savantenvs/acme2certifier
target: order_fuzzer

cmds:
  - cmd: /mayhem/order_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/order_fuzzer/testsuite
