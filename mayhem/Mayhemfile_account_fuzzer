# Atheris (libFuzzer) target: the ELF launcher /mayhem/account_fuzzer execs python3 on mayhem/harnesses/account_fuzzer.py.
project: savantenvs/acme2certifier
target: account_fuzzer

cmds:
  - cmd: /mayhem/account_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/account_fuzzer/testsuite
