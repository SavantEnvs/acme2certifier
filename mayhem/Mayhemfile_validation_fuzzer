# Atheris (libFuzzer) target: the ELF launcher /mayhem/validation_fuzzer execs python3 on mayhem/harnesses/validation_fuzzer.py.
project: savantenvs/acme2certifier
target: validation_fuzzer

cmds:
  - cmd: /mayhem/validation_fuzzer
    libfuzzer: true
    timeout: 10

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/validation_fuzzer/testsuite
